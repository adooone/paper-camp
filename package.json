{
  "name": "@dendelion/paper-camp",
  "version": "0.47.0",
  "description": "Local-first, AI-native project management with retro aesthetics",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.2"
    },
    "onlyBuiltDependencies": [
      "node-pty"
    ]
  },
  "bin": {
    "paper-camp": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./vite": {
      "import": "./dist/vite/index.js",
      "types": "./dist/vite/index.d.ts"
    }
  },
  "files": [
    "dist/chunks",
    "dist/cli",
    "dist/core",
    "dist/mcp",
    "dist/toolbar",
    "dist/types",
    "dist/vite",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && vite build && vite build --config vite.app.config.ts && vite build --config vite.toolbar.config.ts",
    "build:app": "node scripts/fetch-assets.mjs && vite build --config vite.app.config.ts",
    "build:toolbar": "vite build --config vite.toolbar.config.ts",
    "prepack": "tsc && vite build && vite build --config vite.toolbar.config.ts",
    "dev": "vite --config vite.app.config.ts --port 3333",
    "dev:lib": "vite",
    "cli": "bun src/cli/index.ts",
    "check-types": "tsc --noEmit --incremental",
    "lint": "biome check . && node scripts/comment-stats.mjs",
    "lint:write": "biome check --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:changed": "vitest run --changed",
    "test:watch": "vitest",
    "knip": "knip",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "consistency": "knip --include files,dependencies && depcruise src --config .dependency-cruiser.cjs",
    "prepare": "husky",
    "comment-stats": "node scripts/comment-stats.mjs",
    "smoke": "node scripts/pack-smoke-test.mjs && node scripts/daemon-lifecycle-smoke-test.mjs"
  },
  "keywords": [
    "project-management",
    "ai-native",
    "local-first",
    "retro-ui",
    "cli",
    "dashboard"
  ],
  "author": "Dendelion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adooone/paper-camp.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tanstack/query-async-storage-persister": "^5.108.0",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-query-persist-client": "^5.108.0",
    "commander": "^15.1.0",
    "idb-keyval": "^6.3.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "remark-gfm": "4.0.1",
    "web-push": "^4.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@dendelion/folk-ui": "^0.26.0",
    "@tanstack/react-router": "^1.170.46",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "5.1.1",
    "autoprefixer": "^10.6.2",
    "dependency-cruiser": "^18.8.0",
    "husky": "^9.1.7",
    "knip": "^6.46.1",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  }
}
